# Build output
/target/
**/target/
node_modules/
dist/
app/src-tauri/gen/schemas/

# Scratch working dir for nested claude test sessions
/.spike-cwd/

# Never commit secrets or runtime state. The MCP bearer token and the
# claude config files that embed it live in the per-user data dir
# (~/Library/Application Support/Pindot), never here.
mcp-token
*.token
claude-mcp.json
claude-mcp-brain.json
claude-settings.json
.env
.env.*

# Model weights (Whisper etc.) are downloaded at runtime, never committed
*.bin
*.gguf
*.ggml
*.onnx
*.ort
*.safetensors
/.models/

# Audio: only the synthetic test phrase under docs/phase2/ may be committed
*.wav
*.aiff
!docs/phase2/test-utterance.wav

# Local test artefacts
spikes/test-target/test-target
spikes/test-target/*.log
.DS_Store
